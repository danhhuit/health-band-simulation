{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health Band Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "command"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "enum": [
        "setMode",
        "resetSteps",
        "setProfile",
        "setPowerMode",
        "ackAlert",
        "emergencyAction"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "properties": {
        "command": { "const": "setMode" },
        "value": {
          "enum": ["normal", "high_hr", "low_hr", "low_spo2", "fall", "low_battery"]
        }
      },
      "required": ["value"]
    },
    {
      "properties": {
        "command": { "const": "resetSteps" }
      },
      "not": { "required": ["value"] }
    },
    {
      "properties": {
        "command": { "const": "setProfile" },
        "value": { "enum": ["student", "older_adult", "athlete"] }
      },
      "required": ["value"]
    },
    {
      "properties": {
        "command": { "const": "setPowerMode" },
        "value": { "enum": ["normal", "eco"] }
      },
      "required": ["value"]
    },
    {
      "properties": {
        "command": { "const": "ackAlert" }
      },
      "required": ["value"]
    },
    {
      "properties": {
        "command": { "const": "emergencyAction" },
        "value": { "enum": ["cancel", "send"] }
      },
      "required": ["value"]
    }
  ]
}
