{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health Band Device Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceId",
    "eventType",
    "requestId",
    "command",
    "activeMode",
    "profile",
    "gender",
    "wearing",
    "wearMode",
    "sleepStage",
    "powerMode",
    "timestamp",
    "message"
  ],
  "properties": {
    "deviceId": {
      "type": "string",
      "const": "health-band-01"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "DEVICE_STARTED",
        "DEVICE_RECOVERED",
        "COMMAND_ACCEPTED",
        "COMMAND_REJECTED",
        "LOCAL_FALL_BUTTON"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "activeMode": {
      "type": "string",
      "enum": ["normal", "high_hr", "low_hr", "low_spo2", "fall", "low_battery", "sleep"]
    },
    "profile": {
      "type": "string",
      "enum": ["student", "older_adult", "athlete", "child"]
    },
    "gender": {
      "type": "string",
      "enum": ["male", "female"]
    },
    "wearing": {
      "type": "boolean"
    },
    "wearMode": {
      "type": "string",
      "enum": ["auto", "worn", "off_wrist"]
    },
    "sleepStage": {
      "type": "string",
      "enum": ["not_tracked", "awake", "candidate", "light", "deep"]
    },
    "powerMode": {
      "type": "string",
      "enum": ["normal", "eco"]
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  }
}
