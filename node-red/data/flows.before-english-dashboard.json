    {
        "id": "offFunc",
        "type": "function",
        "z": "tab1",
        "name": "Offline",
        "func": "var g=Date.now()-(global.get(\"lts\")||0);if(g>8000&&global.get(\"ofs\")!==true){global.set(\"ofs\",true);var n=Date.now();return{payload:{deviceId:\"health-band-01\",type:\"DEVICE_OFFLINE\",severity:\"critical\",value:null,threshold:null,sourceSeq:0,timestamp:n,message:\"MAT KET NOI!\"}};}if(g<=8000&&global.get(\"ofs\")===true)global.set(\"ofs\",false);return null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 400,
        "wires": [
            [
                "alertMqtt"
            ]
        ]
