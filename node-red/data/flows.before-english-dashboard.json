    {
        "id": "alert1",
        "type": "function",
        "z": "tab1",
        "name": "Alert",
        "func": "var d=msg.payload||{};var a=[];var ac=global.get(\"ac\")||{};var n=Date.now();if(d.heartRate>120)a.push({deviceId:d.deviceId,type:\"HIGH_HEART_RATE\",severity:\"warning\",value:d.heartRate,threshold:120,sourceSeq:d.seq,timestamp:n,message:\"HR cao: \"+d.heartRate+\" BPM\"});if(d.heartRate<50)a.push({deviceId:d.deviceId,type:\"LOW_HEART_RATE\",severity:\"warning\",value:d.heartRate,threshold:50,sourceSeq:d.seq,timestamp:n,message:\"HR thap: \"+d.heartRate+\" BPM\"});if(d.spo2<94)a.push({deviceId:d.deviceId,type:\"LOW_SPO2\",severity:\"warning\",value:d.spo2,threshold:94,sourceSeq:d.seq,timestamp:n,message:\"SpO2 thap: \"+d.spo2+\"%\"});if(d.fallDetected===true)a.push({deviceId:d.deviceId,type:\"FALL_DETECTED\",severity:\"critical\",value:true,threshold:null,sourceSeq:d.seq,timestamp:n,message:\"PHAT HIEN NGA!\"});if(d.battery<=20)a.push({deviceId:d.deviceId,type:\"LOW_BATTERY\",severity:\"warning\",value:d.battery,threshold:20,sourceSeq:d.seq,timestamp:n,message:\"Pin yeu: \"+d.battery+\"%\"});var k=d.deviceId+\"_a\";var c=JSON.stringify(a.map(function(x){return x.type;}).sort());if(c===(ac[k]||\"\"))return null;ac[k]=c;global.set(\"ac\",ac);return a.length?[a.map(function(x){return{payload:x};})]:null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 340,
        "wires": [
            [
                "alertMqtt"
            ]
        ]
