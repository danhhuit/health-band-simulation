{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health Band Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceId",
    "online",
    "uptime",
    "firmwareVersion",
    "activeMode"
  ],
  "properties": {
    "deviceId": {
      "type": "string",
      "const": "health-band-01"
    },
    "online": {
      "type": "boolean"
    },
    "uptime": {
      "type": "integer",
      "minimum": 0
    },
    "firmwareVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "activeMode": {
      "type": "string",
      "enum": ["normal", "high_hr", "low_hr", "low_spo2", "fall", "low_battery"]
    }
  }
}
