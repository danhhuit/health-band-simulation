    {
        "id": "json1",
        "type": "function",
        "z": "tab1",
        "name": "Parse telemetry",
        "func": "var p=msg.payload;try{if(Buffer.isBuffer(p))p=p.toString('utf8');for(var i=0;i<2&&typeof p==='string';i++)p=JSON.parse(p);if(!p||typeof p!=='object'||Array.isArray(p))throw new Error('Payload is not an object');msg.payload=p;return msg;}catch(e){node.warn('Telemetry JSON invalid: '+e.message,msg);return null;}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 100,
        "wires": [
            [
                "split1",
                "alert1",
                "ts1"
            ]
        ]
    },
    {
        "id": "ts1",
        "type": "function",
        "z": "tab1",
        "name": "TS",
        "func": "global.set(\"lts\",Date.now());return null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 1,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 60,
        "wires": [
            []
        ]
    },
    {
        "id": "split1",
        "type": "function",
        "z": "tab1",
        "name": "Split",
        "func": "var d=msg.payload||{};var hr=Number(d.heartRate),sp=Number(d.spo2),bat=Number(d.battery),steps=Number(d.steps);if(!Number.isFinite(hr)||!Number.isFinite(sp)||!Number.isFinite(bat)||!Number.isFinite(steps)){node.warn('Telemetry missing numeric fields',msg);return null;}return[{payload:hr,topic:\"Nhip tim\"},{payload:sp,topic:\"SpO2\"},{payload:bat},{payload:steps},[{payload:hr,topic:\"Nhip tim\"},{payload:sp,topic:\"SpO2\"}],{payload:(d.fallDetected?\"PHAT HIEN NGA\":\"BINH THUONG\")+\" | Buoc: \"+steps+\" | Tin hieu: \"+(d.signalQuality||\"unknown\")}];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 120,
        "wires": [
            [
                "gHr"
            ],
            [
                "gSpo2"
            ],
            [
                "gBat"
            ],
            [
                "tSteps"
            ],
            [
                "chart1"
            ],
            [
                "tStatus"
            ]
        ]
    },
