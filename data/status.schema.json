{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health Band Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceId",
    "online",
    "uptime",
    "firmwareVersion",
    "activeMode",
    "profile",
    "gender",
    "wearing",
    "wearMode",
    "sleepStage",
    "stateRestored",
    "checkpointSequence",
    "powerMode",
    "samplingIntervalMs"
  ],
  "properties": {
    "deviceId": {
      "type": "string",
      "const": "health-band-01"
    },
    "online": {
      "type": "boolean"
    },
    "uptime": {
      "type": "integer",
      "minimum": 0
    },
    "firmwareVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "activeMode": {
      "type": "string",
      "enum": ["normal", "high_hr", "low_hr", "low_spo2", "fall", "low_battery", "sleep"]
    },
    "profile": {
      "type": "string",
      "enum": ["student", "older_adult", "athlete", "child"]
    },
    "gender": {
      "type": "string",
      "enum": ["male", "female"]
    },
    "wearing": {
      "type": "boolean"
    },
    "wearMode": {
      "type": "string",
      "enum": ["auto", "worn", "off_wrist"]
    },
    "sleepStage": {
      "type": "string",
      "enum": ["not_tracked", "awake", "candidate", "light", "deep"]
    },
    "stateRestored": {
      "type": "boolean"
    },
    "checkpointSequence": {
      "type": "integer",
      "minimum": 0
    },
    "powerMode": {
      "type": "string",
      "enum": ["normal", "eco"]
    },
    "samplingIntervalMs": {
      "type": "integer",
      "enum": [2000, 8000]
    }
  }
}
